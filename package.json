{
  "name": "dsh-subscription-search",
  "version": "1.1.0",
  "description": "Ordered, extensible web-search fallback chain for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./search-chain": "./lib/search-chain.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-subscription-search": "bin/install.js"
  },
  "files": [
    "bin/install.js",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/*.js && node --check bin/install.js && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaomingbo/dsh-subscription-search.git"
  },
  "homepage": "https://github.com/shaomingbo/dsh-subscription-search#readme",
  "bugs": {
    "url": "https://github.com/shaomingbo/dsh-subscription-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "search-chain",
    "exa",
    "deepseek",
    "web-search"
  ],
  "author": "shaomingbo",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
